<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF3E0"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Productos Disponibles"
            android:textSize="24sp"
            android:textColor="#E65100"
            android:layout_marginBottom="20dp"/>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="10dp"
            android:background="#FFE0B2"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/imgCamisa"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/camisa"
                android:contentDescription="Camisa" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Camisa Casual"
                    android:textSize="20sp"
                    android:textColor="#BF360C" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$45.000"
                    android:textSize="18sp"
                    android:textColor="#D84315"
                    android:layout_marginBottom="8dp"/>

                <Button
                    android:id="@+id/btnAgregarCamisa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Agregar al carrito"
                    android:backgroundTint="#E65100"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Producto: Pantalón -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="10dp"
            android:background="#FFE0B2"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/imgpantalon"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/pantalon"
                android:contentDescription="pantalon" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pantalón Jeans"
                    android:textSize="20sp"
                    android:textColor="#BF360C" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$90.000"
                    android:textSize="18sp"
                    android:textColor="#D84315"
                    android:layout_marginBottom="8dp"/>

                <Button
                    android:id="@+id/btnAgregarpantalon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Agregar al carrito"
                    android:backgroundTint="#E65100"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnCarrito"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ver Carrito"
            android:layout_marginTop="16dp"
            android:backgroundTint="#0D47A1"
            android:textColor="#FFFFFF"/>

    </LinearLayout>
</ScrollView>


